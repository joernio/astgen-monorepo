{
  "name": "@joernio/astgen",
  "version": "3.43.0",
  "description": "Generate JavaScript/TypeScript AST in JSON format with Babel",
  "exports": "./index.js",
  "keywords": [
    "AST",
    "Static Analysis"
  ],
  "bin": {
    "astgen": "./dist/astgen.js"
  },
  "repository": "https://github.com/joernio/astgen",
  "author": "Max Leuthaeuser",
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "readdirp": "^5.0.0",
    "typescript": "^6.0.3",
    "yargs": "^17.7.2"
  },
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --silent --config=jest.config.js",
    "build": "tsc --build",
    "bundle": "esbuild dist/astgen.js --bundle --platform=node --target=node24 --minify --outfile=build/astgen.js --external:typescript",
    "binary": "yarn build && yarn bundle && pkg build/astgen.js --options max-old-space-size=8192 --compress GZip --fallback-to-source --targets node24-linux-x64,node24-linux-arm64,node24-macos-x64,node24-win-x64,node24-macos-arm64",
    "regression": "astgen-regression local"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "./dist/**/*.js"
  ],
  "directories": {
    "test": "./test/"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/yargs": "^17.0.33",
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9"
  },
  "resolutions": {
    "brace-expansion": ">=2.0.3",
    "picomatch": ">=4.0.4",
    "minimatch": ">=9.0.6"
  }
}
